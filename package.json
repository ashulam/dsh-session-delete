{
    "name":  "dsh-session-delete",
    "version":  "0.1.0",
    "description":  "Delete a session from the sidebar context menu: moves its log directory and projection cache to the Windows Recycle Bin.",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./client/client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "client",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "license":  "MIT",
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-slots",
                                              "@deepseek-ai/dsh-client-ui-workspace"
                                          ]
                           }
            },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/ashulam/dsh-session-delete"
                   },
    "homepage":  "https://github.com/ashulam/dsh-session-delete",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "session",
                     "delete",
                     "recycle-bin"
                 ],
    "author":  "ashulam"
}